void DisplayMenu(string items[],double prices[],int size) {

        cout<<"No."<<"\t"<<"Item"<<"\t\t"<<"Price"<<endl<<endl;

        for(int i=0; i<size; i++) {

            cout<<i+1<<"\t"<<left<<setw(15)<<items[i]<<prices[i]<<"EGP"<<endl;
        }
        cout <<size +1<<"\t"<<left <<setw(15)<<"finish order"<<endl;
    }

    //hamza
    double displayReceipt(string menuItems[], int quantities[], double prices[], int SIZE) {
    double totalBill = 0; //to display the recipt
double subtotal;

    for (int i = 0; i < SIZE; i++) {
        if (quantities[i] > 0) {
        subtotal = quantities[i] * prices[i]; //da 3shan ydrb el quantity f s3r
            cout << menuItems[i] << " x" << quantities[i] << " = " << subtotal << " EGP" << endl;
            totalBill += subtotal;

        }
    }
    //mohamed
    const double TAX_RATE = 0.14;
    double taxAmount = totalBill* TAX_RATE;
    double finalTotal = totalBill + taxAmount;

